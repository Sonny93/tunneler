{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Tunneler",
	"mainBinaryName": "tunneler-ui",
	"version": "0.1.0",
	"identifier": "com.minimalstuff.tunneler",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "Tunneler",
				"width": 1000,
				"height": 700,
				"minWidth": 640,
				"minHeight": 480,
				"visible": false
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"publisher": "minimalstuff",
		"category": "Utility",
		"shortDescription": "Gestionnaire de tunnels SSH",
		"longDescription": "Tunneler gère vos tunnels SSH depuis un démon léger avec icône de notification et une interface à la demande.",
		"copyright": "© 2026 Sonny",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}

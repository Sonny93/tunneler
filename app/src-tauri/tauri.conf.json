{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Tunneler",
	"mainBinaryName": "tunneler-ui",
	"version": "0.5.0",
	"identifier": "com.minimalstuff.tunneler",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "Tunneler",
				"width": 1000,
				"height": 700,
				"minWidth": 640,
				"minHeight": 480,
				"visible": false
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"publisher": "minimalstuff",
		"category": "Utility",
		"shortDescription": "SSH tunnel manager",
		"longDescription": "Tunneler manages your SSH tunnels from a lightweight daemon with a notification-area icon and an on-demand interface.",
		"copyright": "© 2026 Sonny",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyMzA4RjA2OTU1RERFNkUKUldSdTNsMlZCbzh3TW1LMDhROXNVOXZJMmIxMjc0N2wvY3U4M2RzR04zSVpOQ2UrUFp5ZGVGOUwK",
			"endpoints": [
				"https://github.com/Sonny93/tunneler/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}

{
	"$schema": "https://schema.tauri.app/config/2",
	"bundle": {
		"targets": ["nsis"],
		"externalBin": ["binaries/tunneler"],
		"windows": {
			"nsis": {
				"installMode": "both",
				"startMenuFolder": "Tunneler",
				"languages": ["French"],
				"customLanguageFiles": {
					"French": "windows/French.nsh"
				},
				"installerHooks": "windows/hooks.nsh"
			}
		}
	}
}

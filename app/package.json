{
	"name": "tunneler-ui",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"tauri": "tauri",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix --fix-suggestions",
		"format": "oxfmt . && oxlint . --fix",
		"format:check": "oxfmt . --check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"i18n:extract": "lingui extract --clean",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
		"release": "release-it"
	},
	"dependencies": {
		"@lingui/core": "^6.10.1",
		"@lingui/react": "^6.10.1",
		"@minimalstuff/ui": "^4.3.3",
		"@tauri-apps/api": "^2.12.4",
		"clsx": "^2.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.2.3",
		"@lingui/cli": "^6.10.1",
		"@lingui/swc-plugin": "^6.7.1",
		"@lingui/vite-plugin": "^6.10.1",
		"@minimalstuff/tooling": "^0.7.0",
		"@release-it/bumper": "^8.0.1",
		"@release-it/keep-a-changelog": "^8.0.1",
		"@tauri-apps/cli": "^2.12.4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"axe-core": "^4.14.0",
		"jsdom": "^30.1.3",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"release-it": "^21.1.1",
		"typescript": "~7.0.2",
		"unocss": "^66.12.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-axe": "^0.1.0"
	},
	"packageManager": "pnpm@12.16.1"
}

{
	"$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
	"git": {
		"requireBranch": "main",
		"requireCleanWorkingDir": true,
		"commitMessage": "chore(release): v${version}",
		"tagName": "v${version}",
		"tagAnnotation": "Tunneler ${version}",
		"push": true
	},
	"npm": {
		"publish": false
	},
	"github": {
		"release": true,
		"draft": true,
		"releaseName": "Tunneler ${version}"
	},
	"hooks": {
		"after:bump": [
			"cargo update -w --offline",
			"oxfmt src-tauri/tauri.conf.json",
			"git add ../Cargo.toml ../Cargo.lock"
		]
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"preset": {
				"name": "conventionalcommits",
				"preMajor": true
			},
			"infile": "../CHANGELOG.md",
			"header": "# Changelog"
		},
		"@release-it/bumper": {
			"out": [
				{
					"file": "../Cargo.toml",
					"type": "text/toml",
					"path": "workspace.package.version"
				},
				{ "file": "src-tauri/tauri.conf.json", "path": "version" }
			]
		}
	}
}

{
	"$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
	"git": {
		"requireBranch": "main",
		"requireCleanWorkingDir": true,
		"commitMessage": "chore(release): v${version}",
		"tagName": "v${version}",
		"tagAnnotation": "Tunneler ${version}",
		"push": true
	},
	"npm": {
		"publish": false
	},
	"github": {
		"release": true,
		"draft": true,
		"releaseName": "Tunneler ${version}"
	},
	"hooks": {
		"after:bump": [
			"cargo update -w --offline",
			"oxfmt src-tauri/tauri.conf.json",
			"git add ../Cargo.toml ../Cargo.lock"
		],
		"before:git:release": ["git add ../CHANGELOG.md"]
	},
	"plugins": {
		"@release-it/keep-a-changelog": {
			"filename": "../CHANGELOG.md",
			"addUnreleased": true,
			"addVersionUrl": true,
			"head": "main"
		},
		"@release-it/bumper": {
			"out": [
				{
					"file": "../Cargo.toml",
					"type": "text/toml",
					"path": "workspace.package.version"
				},
				{
					"file": "src-tauri/tauri.conf.json",
					"path": "version"
				}
			]
		}
	}
}
